<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 两条既有告警与本轮无关：CS8618 是事件字段未初始化，CS0618 是 ViGEm 的
         FeedbackReceived 已被上游标成过时（行为不能动）。保留代码原样，只压掉噪声。 -->
    <NoWarn>$(NoWarn);CS8618;CS0618</NoWarn>

	  <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="SIPSorcery" Version="10.0.8" />
    <!-- Microsoft.NET.Sdk.Web 已隐式引入 Microsoft.AspNetCore.App，再显式写一次会触发 NETSDK1086。 -->
  </ItemGroup>

</Project>
