<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- ViGEm 的 FeedbackReceived 已被上游标成过时，行为不能动，只压掉这一条。 -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>

	  <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="SIPSorcery" Version="10.0.8" />
    <!-- Microsoft.NET.Sdk.Web 已隐式引入 Microsoft.AspNetCore.App，再显式写一次会触发 NETSDK1086。 -->
  </ItemGroup>

</Project>
